# Ground Truth connector credentials
GROUND_TRUTH_APP_ID=
GROUND_TRUTH_APP_SECRET=

# User token with ads_read — required for listing accounts and insights
GROUND_TRUTH_ACCESS_TOKEN=

# Default ad account — numeric ID only, without act_ prefix
GROUND_TRUTH_AD_ACCOUNT_ID=

# Optional: gate OAuth authorize step (Cloud Run / Claude connectors)
# MCP_OAUTH_PASSWORD=

# Set automatically by deploy-cloudrun.ps1 on Cloud Run (do not set locally)
# MCP_PUBLIC_URL=https://ground-truth-mcp-xxxxx-uc.a.run.app

# Optional: durable Claude OAuth sessions on Cloud Run (recommended)
# deploy-cloudrun.ps1 creates ground-truth-mcp-oauth-state-PROJECT and sets this.
# Without it, tokens live only in /tmp and Claude shows session timeout after deploys.
# MCP_OAUTH_GCS_BUCKET=ground-truth-mcp-oauth-state-your-project-id

# Optional: local OAuth state path (Cloud Run default: /tmp/ground-truth-mcp-oauth-state.json)
# MCP_OAUTH_STATE_PATH=/tmp/ground-truth-mcp-oauth-state.json
