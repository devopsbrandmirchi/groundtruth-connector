# GroundTruth Reporting API credentials (request from GroundTruth support)
# Sent as X-GT-USER-ID / X-GT-API-KEY headers on every request.
GROUND_TRUTH_USER_ID=
GROUND_TRUTH_API_KEY=

# Organization ID — used to list accounts/campaigns and look up campaigns by name
GROUND_TRUTH_ORG_ID=

# Optional defaults
# GROUND_TRUTH_ACCOUNT_ID=
# GROUND_TRUTH_TENANT_ID=
# GROUND_TRUTH_API_BASE=https://reporting.groundtruth.com
# GROUND_TRUTH_DATE_FORMAT=%Y-%m-%d

# Stable secret that signs Claude OAuth tokens. Must never change, or Claude
# has to reconnect. deploy-cloudrun.ps1 generates one in Secret Manager once.
# MCP_OAUTH_JWT_SECRET=

# Optional: gate OAuth authorize step (Cloud Run / Claude connectors)
# MCP_OAUTH_PASSWORD=

# Set automatically by deploy-cloudrun.ps1 on Cloud Run (do not set locally)
# MCP_PUBLIC_URL=https://ground-truth-mcp-xxxxx-uc.a.run.app
